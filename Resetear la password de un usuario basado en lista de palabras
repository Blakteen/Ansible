---
- name: Crear usuario en AD con contraseña segura (Solo requiere ad_username)
  hosts: all
  gather_facts: no
  vars:
    ad_username: "{{ ad_username }}"  # Única variable requerida
    # Las demás se generan automáticamente
    ad_display_name: "{{ ad_username | capitalize }}"
    ad_logon_name: "{{ ad_username }}@mingrat.lab"
    ad_ou: "OU=Usuarios,DC=mingrat,DC=lab"
    ad_groups: 
      - "Usuarios del dominio"

  tasks:
    - name: Lista de palabras para la contraseña
      set_fact:
        palabras:
          [
            "Lunes", "Rojo", "Dedo", "Casa", "Perro", "Gato",
            "Sol", "Cielo", "Reloj", "Silla", "Mesa", "Viento",
            "Mar", "Flor", "Piedra", "Libro", "Puerta", "Ventana",
            "Camino", "Montaña", "Rio", "Nube", "Arbol", "Hoja"
          ]

    - name: Generar palabras aleatorias
      set_fact:
        palabra1: "{{ palabras | random }}"
        palabra2: "{{ palabras | random }}"
        palabra3: "{{ palabras | random }}"

    - name: Generar número y carácter especial aleatorio
      set_fact:
        numero: "{{ lookup('ansible.builtin.random_string', length=2, digits=True) }}"
        caracter: "{{ lookup('ansible.builtin.random_string', length=1, special=True) }}"

    - name: Construir la contraseña final
      set_fact:
        random_password: "{{ palabra1 }}{{ palabra2 }}{{ palabra3 }}{{ numero }}{{ caracter }}"

    - name: Verificar si el usuario ya existe en AD
      win_shell: |
        try {
            $user = Get-ADUser -Identity "{{ ad_username }}" -ErrorAction Stop
            Write-Output "EXISTS"
        } catch {
            Write-Output "NOT_EXISTS"
        }
      register: user_check
      args:
        executable: powershell

    - name: Crear usuario en Active Directory
      win_shell: |
        $SecurePassword = ConvertTo-SecureString "{{ random_password }}" -AsPlainText -Force
        
        New-ADUser `
          -Name "{{ ad_display_name }}" `
          -SamAccountName "{{ ad_username }}" `
          -UserPrincipalName "{{ ad_logon_name }}" `
          -AccountPassword $SecurePassword `
          -Enabled $true `
          -Path "{{ ad_ou }}" `
          -DisplayName "{{ ad_display_name }}" `
          -Description "Usuario creado desde AWX con contraseña segura" `
          -ChangePasswordAtLogon $false `
          -PasswordNeverExpires $true
      when: user_check.stdout == "NOT_EXISTS"
      register: create_user
      args:
        executable: powershell

    - name: Actualizar contraseña si el usuario existe
      win_shell: |
        $SecurePassword = ConvertTo-SecureString "{{ random_password }}" -AsPlainText -Force
        Set-ADAccountPassword -Identity "{{ ad_username }}" -NewPassword $SecurePassword -Reset
        Write-Output "Contraseña actualizada para usuario existente"
      when: user_check.stdout == "EXISTS"
      register: update_password
      args:
        executable: powershell

    - name: Habilitar usuario si estaba deshabilitado
      win_shell: |
        Enable-ADAccount -Identity "{{ ad_username }}"
        Write-Output "Usuario habilitado"
      when: user_check.stdout == "EXISTS"
      args:
        executable: powershell

    - name: Agregar usuario a grupos AD por defecto
      win_shell: |
        $groups = @("Usuarios del dominio")
        
        foreach ($group in $groups) {
            try {
                $isMember = Get-ADGroupMember -Identity $group | Where-Object {$_.SamAccountName -eq "{{ ad_username }}"}
                if (-not $isMember) {
                    Add-ADGroupMember -Identity $group -Members "{{ ad_username }}" -ErrorAction Stop
                    Write-Output "✅ Usuario agregado al grupo: $group"
                } else {
                    Write-Output "ℹ️  Usuario ya es miembro del grupo: $group"
                }
            } catch {
                Write-Warning "⚠️ Error con el grupo $group : $_"
            }
        }
      args:
        executable: powershell
      register: add_groups_result

    - name: Mostrar resumen final
      debug:
        msg: |
          🎉 USUARIO CONFIGURADO EN ACTIVE DIRECTORY
          ─────────────────────────────────────────
          👤 Usuario: {{ ad_username }}
          📝 Nombre: {{ ad_display_name }}
          📧 Email: {{ ad_logon_name }}
          🔐 Contraseña: {{ random_password }}
          📍 OU: {{ ad_ou }}
          
          {% if user_check.stdout == "EXISTS" %}
          🔄 Acción: Contraseña actualizada
          {% else %}
          ✅ Acción: Usuario creado
          {% endif %}
          
          📋 Grupo: Usuarios del dominio
          
          💡 INICIAR SESIÓN CON:
          • Usuario: {{ ad_username }}
          • Contraseña: {{ random_password }}
          • O con: {{ ad_username }}@mingrat.lab
